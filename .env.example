# ==============================================================================
# PressingOS — Exemple de Configuration d'Environnement (.env.example)
# ==============================================================================
# IMPORTANT : Ne placez JAMAIS de secrets réels dans ce fichier ou dans Git.
# Pour le développement local, copiez ce fichier vers .env :
#   cp .env.example .env
# ==============================================================================

# --- BASE DE DONNÉES POSTGRESQL (Docker Compose) ---
POSTGRES_USER=pressing_app
POSTGRES_PASSWORD=pressing_secret_local_dev_change_me
POSTGRES_DB=pressing_os
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgres://pressing_app:pressing_secret_local_dev_change_me@localhost:5432/pressing_os?sslmode=disable

# --- BASE NEON (PRODUCTION, managée) ---
# Si défini, NEON_DATABASE_URL prend la priorité sur DATABASE_URL.
# TLS obligatoire côté Neon : terminer par ?sslmode=require
NEON_DATABASE_URL=

# --- BACKEND API GO ---
PORT=8080
SERVER_ENV=development
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
READ_TIMEOUT_SECONDS=10
WRITE_TIMEOUT_SECONDS=10
IDLE_TIMEOUT_SECONDS=60

# --- PRÉVISUALISATION / HÔTES AUTORISÉS (facultatif) ---
# Par défaut, le serveur de développement accepte tout nom d'hôte (prévisualisations
# managées à domaine dynamique). Restreindre si besoin (liste séparée par des virgules).
VITE_ALLOWED_HOSTS=

# --- NOTIFICATIONS CLIENTS (WhatsApp / SMS — facultatif) ---
# Sans URL, les messages sont composés et journalisés (status "simule") et l'interface
# propose l'ouverture manuelle de WhatsApp / SMS depuis le téléphone du comptoir.
# Avec URL, chaque envoi payant (notifications.advanced) est transmis en POST JSON
# {to, channel, body, order_id, tenant_id} à ce webhook — le fournisseur réel
# (WhatsApp Business API, agrégateur SMS) se branche derrière.
NOTIFICATIONS_GATEWAY_URL=
NOTIFICATIONS_GATEWAY_TOKEN=

# --- FRONTEND (Next.js / Vite React) ---
NEXT_PUBLIC_API_URL=http://localhost:8080
VITE_API_URL=http://localhost:8080
# Adresse de contact de l'éditeur pour le passage à une autre formule (facultatif).
# Sans valeur, l'écran « Mon abonnement » demande de contacter l'éditeur sans lien mailto.
# VITE_BILLING_CONTACT_EMAIL=contact@exemple.ci

# --- AI STUDIO RUNTIME (Optionnel pour déploiement hébergé) ---
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
