# ==============================================================================
# PressingOS — Exemple de Configuration d'Environnement (.env.example)
# ==============================================================================
# IMPORTANT : Ne placez JAMAIS de secrets réels dans ce fichier ou dans Git.
# Pour le développement local, copiez ce fichier vers .env :
#   cp .env.example .env
# ==============================================================================

# --- BASE DE DONNÉES POSTGRESQL (Docker Compose) ---
POSTGRES_USER=pressing_app
POSTGRES_PASSWORD=pressing_secret_local_dev_change_me
POSTGRES_DB=pressing_os
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgres://pressing_app:pressing_secret_local_dev_change_me@localhost:5432/pressing_os?sslmode=disable

# --- BASE NEON (PRODUCTION, managée) ---
# Si défini, NEON_DATABASE_URL prend la priorité sur DATABASE_URL.
# TLS obligatoire côté Neon : terminer par ?sslmode=require
NEON_DATABASE_URL=

# --- BACKEND API GO ---
PORT=8080
SERVER_ENV=development
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
READ_TIMEOUT_SECONDS=10
WRITE_TIMEOUT_SECONDS=10
IDLE_TIMEOUT_SECONDS=60

# --- FRONTEND (Next.js / Vite React) ---
NEXT_PUBLIC_API_URL=http://localhost:8080
VITE_API_URL=http://localhost:8080

# --- AI STUDIO RUNTIME (Optionnel pour déploiement hébergé) ---
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
